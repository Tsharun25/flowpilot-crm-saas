generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  tasks            Task[]
  clientNotes      ClientNote[]
  clientActivities ClientActivity[]
}

model Workspace {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Membership[]
  projects Project[]
  clients  Client[]
}

model Membership {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  role Role   @default(MEMBER)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  tasks      Task[]
  clientId   String?         @db.ObjectId
  client     Client?         @relation("ClientProjects", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversion DealConversion?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([workspaceId])
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])

  assigneeId String? @db.ObjectId
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Client {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String?
  company      String?
  /// Legacy whole-dollar value retained so existing MongoDB documents remain readable.
  value        Int          @default(0)
  /// Exact USD amount in cents for new and edited records.
  valueCents   BigInt?
  status       ClientStatus @default(LEAD)
  wonAt        DateTime?
  nextFollowUp DateTime?

  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  projects   Project[]        @relation("ClientProjects")
  conversion DealConversion?
  notes      ClientNote[]
  activities ClientActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status, wonAt])
  @@index([workspaceId, nextFollowUp])
}

model DealConversion {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId  String   @unique @db.ObjectId
  client    Client   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String   @unique @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
}

model ClientNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  requestId String   @unique
  clientId  String   @db.ObjectId
  client    Client   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model ClientActivity {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  kind      ClientActivityKind
  summary   String
  eventKey  String             @unique
  clientId  String             @db.ObjectId
  client    Client             @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId   String             @db.ObjectId
  actor     User               @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime           @default(now())

  @@index([clientId, createdAt])
}

model RateLimit {
  id          String   @id @map("_id")
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClientStatus {
  LEAD
  CONTACTED
  WON
  LOST
}

enum ClientActivityKind {
  STATUS_CHANGE
  CONVERSION
}
