{
  "name": "flowpilot-crm",
  "version": "1.3.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env .next/standalone/server.js",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --confirm-demo-reset",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:money-browser": "node scripts/decimal-browser-audit.mjs",
    "audit:task-priority": "node scripts/task-priority-browser-audit.mjs",
    "audit:workflow": "node scripts/workflow-browser-audit.mjs",
    "audit:isolation": "node scripts/isolation-browser-audit.mjs",
    "test:metrics": "tsx scripts/test-crm-metrics.ts",
    "test:demo-safety": "tsx scripts/test-demo-workspace.ts",
    "test:workflow-utils": "tsx scripts/test-workflow-utils.ts",
    "test:rate-limit": "tsx scripts/test-rate-limit.ts",
    "verify": "prisma generate && prisma validate && npm run test:metrics && npm run test:demo-safety && npm run test:workflow-utils && npm run test:rate-limit && npm run lint && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.16.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.1",
    "sonner": "2.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "playwright": "1.64.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
