# MongoDB Atlas or MongoDB replica-set connection string
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/flowpilot?retryWrites=true&w=majority"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Separate random salt for hashed shared rate-limit keys (falls back to NEXTAUTH_SECRET)
RATE_LIMIT_SALT="replace-with-another-long-random-secret"

# Local: http://localhost:3000 | Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Absolute public origin used for canonical, Open Graph, robots, and sitemap URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Exact trusted origin used only to build password-reset links.
# Production requires HTTPS and rejects credentials, paths, queries, and fragments.
PASSWORD_RESET_ORIGIN="http://localhost:3000"

# Optional HTTPS help-desk/contact page; omit to use the built-in support guidance
NEXT_PUBLIC_SUPPORT_URL="https://your-domain.com/support"

# Transactional email through Resend (server-side only). Verify the sender domain first.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="FlowPilot <no-reply@your-verified-domain.com>"

# Dedicated non-production password used only by `npm run seed:demo` (minimum 12 characters)
DEMO_PASSWORD="replace-with-a-dedicated-demo-password"
